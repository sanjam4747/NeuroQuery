# ==============================================================================
# NeuroQuery Backend Configuration Template
# Copy this file to .env and adjust variables as required for your environment.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Application Metadata
APP_NAME=NeuroQuery
APP_ENV=development
APP_DEBUG=true
API_V1_STR=/api/v1

# Server Settings
HOST=0.0.0.0
PORT=8000

# CORS Configuration (comma-separated list of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=neuroquery_user
POSTGRES_PASSWORD=neuroquery_pass
POSTGRES_DB=neuroquery

# Optional explicit Database URL (if set, overrides individual POSTGRES_* parameters)
# Example: postgresql+psycopg://neuroquery_user:neuroquery_pass@localhost:5432/neuroquery
DATABASE_URL=

# Document Storage & Ingestion (Phase 2)
STORAGE_DIR=storage/documents
MAX_UPLOAD_SIZE_BYTES=26214400
CHUNK_SIZE=1500
CHUNK_OVERLAP=200

# Semantic Embeddings & Vector Storage (Phase 3)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=auto
EMBEDDING_NORMALIZE=true

# Hybrid Retrieval & Relevance Settings (Phase 4)
DENSE_RETRIEVAL_TOP_K=20
BM25_RETRIEVAL_TOP_K=20
RRF_CONSTANT=60
HYBRID_RETRIEVAL_TOP_K=20
RERANKER_TOP_K=5
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_BATCH_SIZE=16
RERANKER_DEVICE=auto
ENABLE_RERANKING=true

# Generation & RAG Orchestration (Phase 5)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=qwen2.5:1.5b-instruct
LLM_REQUEST_TIMEOUT_SECONDS=60.0
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=1024
LLM_MAX_CONCURRENT_REQUESTS=2
RAG_CONTEXT_MAX_TOKENS=2048
RAG_MAX_EVIDENCE_CHUNKS=5
RAG_SIMILARITY_OVERLAP_THRESHOLD=0.85
RAG_ENABLE_STRUCTURED_OUTPUT=true
